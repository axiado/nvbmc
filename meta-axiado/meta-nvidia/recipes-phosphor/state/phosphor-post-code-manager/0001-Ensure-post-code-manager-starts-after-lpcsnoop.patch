From 667c291476d7e7ae97320161efe413ef25305838 Mon Sep 17 00:00:00 2001
From: Ginu George <axiado-2551@axiado.com>
Date: Mon, 13 Apr 2026 05:19:18 -0700
Subject: [PATCH] Ensure post code manager starts after lpcsnoop

Signed-off-by: Ginu George <axiado-2551@axiado.com>
---
 .../xyz.openbmc_project.State.Boot.PostCode@.service          | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/service_files/xyz.openbmc_project.State.Boot.PostCode@.service b/service_files/xyz.openbmc_project.State.Boot.PostCode@.service
index db21c21..906cebc 100644
--- a/service_files/xyz.openbmc_project.State.Boot.PostCode@.service
+++ b/service_files/xyz.openbmc_project.State.Boot.PostCode@.service
@@ -1,7 +1,11 @@
 [Unit]
 Description=Post code manager (host %i)
+Requires=lpcsnoop.service
+After=lpcsnoop.service
 
 [Service]
+Restart=always
+RestartSec=5
 ExecStart=/usr/bin/env post-code-manager --host %i
 SyslogIdentifier=post-code-manager%i
 Type=dbus
-- 
2.34.1

