From b323c88c3992e8d83f9ec3190ffb0b122d3e0d01 Mon Sep 17 00:00:00 2001
From: Adarsh Kumar <adarsh.kumar@axiado.com>
Date: Fri, 13 Feb 2026 04:33:32 -0800
Subject: [PATCH] KWS-7656 enable factory reset feature

Upstream-Status: Pending

diff --git a/bmc/inventory_manager.hpp b/bmc/inventory_manager.hpp
index 592d855..7290c37 100644
--- a/bmc/inventory_manager.hpp
+++ b/bmc/inventory_manager.hpp
@@ -117,8 +117,13 @@ class InventoryManager :
     {
         constexpr auto setFactoryResetWait = std::chrono::seconds(3);
         // Mark the read-write partition for recreation upon reboot.
-        utils::execute("/sbin/fw_setenv", "openbmconce", "factory-reset");
-
+	#ifdef MMC_LAYOUT
+	    // eMMC platform: correct behavior
+            utils::execute("/sbin/fw_setenv", "rwreset", "true");
+       #else
+           // NOR/SPI-NOR platform: original upstream behavior
+           utils::execute("/sbin/fw_setenv", "openbmconce", "factory-reset");
+	#endif
         // used to create a RF log upon reboot
         utils::execute("/sbin/fw_setenv", "openbmclog", "factory-reset");
 
-- 
