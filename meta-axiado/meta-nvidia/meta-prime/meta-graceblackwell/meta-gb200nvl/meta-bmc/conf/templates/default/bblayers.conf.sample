# LAYER_CONF_VERSION is increased each time build/conf/bblayers.conf
# changes incompatibly
LCONF_VERSION = "20"

BBPATH = "${TOPDIR}"
BBFILES ?= ""

#In this phase, phosphor-debug-collector is used from Nvidia. So, ignore core.
BBMASK += "/meta-ami/meta-common/recipes-phosphor/dump/phosphor-debug-collector_%.bbappend"

BBLAYERS ?= " \
  ##OEROOT##/meta \
  ##OEROOT##/meta-ami \
  ##OEROOT##/meta-openembedded/meta-oe \
  ##OEROOT##/meta-openembedded/meta-networking \
  ##OEROOT##/meta-openembedded/meta-perl \
  ##OEROOT##/meta-openembedded/meta-python \
  ##OEROOT##/meta-phosphor \
  ##OEROOT##/meta-aspeed \
  ##OEROOT##/meta-core \
  ##OEROOT##/meta-intel-openbmc \
  ##OEROOT##/meta-core/meta-common \
  ##OEROOT##/meta-core/meta-ast2600 \
  ##OEROOT##/meta-security \
  ##OEROOT##/meta-axiado \
  ##OEROOT##/meta-nvidia \
  ##OEROOT##/meta-nvidia/meta-common-next \
  ##OEROOT##/meta-nvidia/meta-common-next/meta-bmc-common \
  ##OEROOT##/meta-nvidia/meta-common-next/meta-nvl-common \
  ##OEROOT##/meta-nvidia/meta-common-next/meta-nvl-common/meta-gb200nvl \
  ##OEROOT##/meta-axiado/meta-common \
  ##OEROOT##/meta-axiado/meta-nvidia \
  ##OEROOT##/meta-axiado/meta-nvidia/meta-prime \
  ##OEROOT##/meta-axiado/meta-nvidia/meta-prime/meta-bmc-common \
  ##OEROOT##/meta-axiado/meta-nvidia/meta-prime/meta-graceblackwell \
  ##OEROOT##/meta-axiado/meta-nvidia/meta-prime/meta-graceblackwell/meta-gb200nvl \
  ##OEROOT##/meta-axiado/meta-nvidia/meta-prime/meta-graceblackwell/meta-gb200nvl/meta-bmc \
  "
BBLAYERS_NON_REMOVABLE ?= " \
  ##OEROOT##/meta \
  ##OEROOT##/meta-ami \
  ##OEROOT##/meta-openembedded/meta-oe \
  ##OEROOT##/meta-openembedded/meta-networking \
  ##OEROOT##/meta-openembedded/meta-perl \
  ##OEROOT##/meta-openembedded/meta-python \
  ##OEROOT##/meta-phosphor \
  ##OEROOT##/meta-aspeed \
  ##OEROOT##/meta-core \
  ##OEROOT##/meta-intel-openbmc \
  ##OEROOT##/meta-core/meta-common \
  ##OEROOT##/meta-core/meta-ast2600 \
  ##OEROOT##/meta-security \
  ##OEROOT##/meta-axiado \
  ##OEROOT##/meta-nvidia \
  ##OEROOT##/meta-nvidia/meta-common-next \
  ##OEROOT##/meta-nvidia/meta-common-next/meta-bmc-common \
  ##OEROOT##/meta-nvidia/meta-common-next/meta-nvl-common \
  ##OEROOT##/meta-nvidia/meta-common-next/meta-nvl-common/meta-gb200nvl \
  "