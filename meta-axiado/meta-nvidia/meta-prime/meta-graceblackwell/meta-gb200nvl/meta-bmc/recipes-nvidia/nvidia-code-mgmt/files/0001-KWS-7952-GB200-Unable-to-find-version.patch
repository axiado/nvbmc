From 050feea40f8fbf8ad9b5098f39277e3463028397 Mon Sep 17 00:00:00 2001
From: Punith Nadur <axiado-2522@axiado.com>
Date: Wed, 25 Feb 2026 02:56:32 +0000
Subject: [PATCH] KWS-7952-GB200-Unable-to-find-version

The TCUItemUpdater::getVersion() was returning an empty string,
causing the Redfish FirmwareInventory/BMC endpoint to show an
empty Version field.

Fix: Read the VERSION= key from /etc/os-release and set it on
the SoftwareVersion D-Bus object so Redfish displays the correct
BMC firmware version.

Tested: Verified on GB200 Carlo platform.
  - Before: GET FirmwareInventory/BMC -> Version: ""
  - After:  GET FirmwareInventory/BMC -> Version: "SCM3000MGX_0.18.0_B326"

Upstream-Status: Pending

Signed-off-by: Punith Nadur <axiado-2522@axiado.com>
---
 src/axiado_updater.cpp | 20 +++++++++++++++++++-
 1 file changed, 19 insertions(+), 1 deletion(-)

diff --git a/src/axiado_updater.cpp b/src/axiado_updater.cpp
index b55c0f7..204fd1b 100644
--- a/src/axiado_updater.cpp
+++ b/src/axiado_updater.cpp
@@ -16,7 +16,25 @@ namespace updater
 std::string TCUItemUpdater::getVersion(
     [[maybe_unused]] const std::string& inventoryPath) const
 {
-    return "";
+    std::string ret = "";
+    const std::string key = "VERSION=";
+    std::ifstream efile("/etc/os-release");
+    std::string line;
+    while (std::getline(efile, line))
+    {
+        if (line.compare(0, key.size(), key) == 0)
+        {
+            ret = line.substr(key.size());
+            if (!ret.empty() && ret.front() == '"')
+                ret = ret.substr(1);
+            if (!ret.empty() && ret.back() == '"')
+                ret.pop_back();
+            break;
+        }
+    }
+    if (softwareVersionObj && !ret.empty())
+        softwareVersionObj->version(ret);
+    return ret;
 }
 
 std::string TCUItemUpdater::getManufacturer(
