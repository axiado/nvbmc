From 6cb1daf9782db0646cb790e415f66e73914f9be6 Mon Sep 17 00:00:00 2001
From: Krutik Shah <krutikshah@axiado.com>
Date: Mon, 9 Mar 2026 07:43:13 -0700
Subject: [PATCH] obmc ikvm link udc mt nvidia for github

Cherry-pick from http://sourcevault.axiadord:7990/projects/NGRACE/repos/openbmc/pull-requests/607/overview

AXBUGS-2389: KVM: Fixed KVM reconnect failed

Upstream-Status: Pending
---
 create_usbhid.sh | 20 ++++++++++++++++
 ikvm_input.cpp   | 59 +++++++++++++++++++++++++++++++++++++++++++++++-
 ikvm_input.hpp   |  2 ++
 3 files changed, 80 insertions(+), 1 deletion(-)

diff --git a/create_usbhid.sh b/create_usbhid.sh
index 58e4034..7d19c80 100644
--- a/create_usbhid.sh
+++ b/create_usbhid.sh
@@ -3,6 +3,14 @@
 hid_conf_directory="/sys/kernel/config/usb_gadget/obmc_hid"
 dev_name="1e6a0000.usb-vhub"
 
+UDC_PATH="/sys/class/udc"
+axiado_dev_name=$(ls -1 "$UDC_PATH" | head -n 1)
+# Get current power state via D-Bus
+power_state=$(busctl get-property xyz.openbmc_project.State.Chassis \
+        /xyz/openbmc_project/state/chassis0 \
+        xyz.openbmc_project.State.Chassis \
+        CurrentPowerState | awk '{print $2}' | tr -d '"')
+
 create_hid() {
     # create gadget
     mkdir "${hid_conf_directory}"
@@ -138,12 +146,24 @@ connect_hid() {
         done
         echo "${dev_name}:p${port}" > UDC
     fi
+    if ! grep -q "${axiado_dev_name}" UDC; then
+	if [[ "$power_state" == *".PowerState.On" ]]; then # host power monitoring
+		echo "${axiado_dev_name}" > UDC
+		echo "UDC KVM connect" > /dev/console
+	fi
+    fi
 }
 
 disconnect_hid() {
     if grep -q "${dev_name}:p" UDC; then
         echo "" > UDC
     fi
+    if ! grep -q "${axiado_dev_name}" UDC; then
+	if [[ "$power_state" == *".PowerState.On" ]]; then # host power monitoring
+		echo "" > UDC
+		echo "UDC KVM disconnect" > /dev/console
+	fi
+    fi
 }
 
 if [ ! -e "${hid_conf_directory}" ]; then
diff --git a/ikvm_input.cpp b/ikvm_input.cpp
index 8cdefe4..419d490 100644
--- a/ikvm_input.cpp
+++ b/ikvm_input.cpp
@@ -54,6 +54,9 @@ void Input::connect()
         if (udcName.empty())
         {
             bool found = false;
+	    if (fs::exists(usbVirtualHubPath) &&
+			    fs::is_directory(usbVirtualHubPath))
+	    {
             for (const auto& port : fs::directory_iterator(usbVirtualHubPath))
             {
                 // /sys/bus/platform/devices/1e6a0000.usb-vhub/1e6a0000.usb-vhub:pX
@@ -83,7 +86,61 @@ void Input::connect()
                     break;
                 }
             }
-        }
+	    }
+
+            if (fs::exists(udcClassPath) &&
+                fs::is_directory(udcClassPath))
+            {
+                std::string bindUdc;
+                for (const auto& entry :
+                     fs::directory_iterator(udcClassPath))
+                {
+                    if (!fs::is_directory(entry))
+                        continue;
+                    const std::string name =
+			    entry.path().filename().string();
+		    fs::path realPath = fs::canonical(entry.path());
+		    fs::path deviceRoot =
+			    realPath.parent_path().parent_path();
+		    for (const auto& gadget :
+				    fs::directory_iterator(deviceRoot))
+		    {
+			    if (!fs::is_directory(gadget))
+				    continue;
+			       const std::string gname =
+				       gadget.path().filename().string();
+			       if (gname.rfind("gadget.", 0) == 0)
+			       {
+
+				       bindUdc = name;
+				       // Read current binding
+				       std::string currentUdc;
+				       {
+					       std::ifstream check(hidUdcPath);
+					       if (check)
+					       {
+						       std::getline(check, currentUdc);
+					       }
+				       }
+				       // Only bind if not already bound
+				       if (currentUdc != bindUdc)
+				       {
+					       if (!currentUdc.empty())
+					       {
+						       hidUdcStream << "" << std::endl;
+					       }
+					       hidUdcStream << bindUdc << std::endl;
+				       }
+				       break;
+			       }
+		    }
+		}
+                if (bindUdc.empty())
+                {
+                    throw std::runtime_error("No UDC found");
+                }
+	    }
+	}
         else // If UDC has been specified by '-u' parameter, connect to it.
         {
             hidUdcStream << udcName << std::endl;
diff --git a/ikvm_input.hpp b/ikvm_input.hpp
index 00d8e7f..43fb7d5 100644
--- a/ikvm_input.hpp
+++ b/ikvm_input.hpp
@@ -84,6 +84,8 @@ class Input
     /* @brief Path to the USB virtual hub */
     static constexpr const char* usbVirtualHubPath =
         "/sys/bus/platform/devices/1e6a0000.usb-vhub";
+    static constexpr const char* udcClassPath =
+        "/sys/class/udc";
     /* @brief Retry limit for writing an HID report */
     static constexpr int HID_REPORT_RETRY_MAX = 5;
     /*
