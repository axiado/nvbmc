From 08fc0c5c02381415d6b3001e7e475fc5921d32ba Mon Sep 17 00:00:00 2001
From: Ginu George <axiado-2551@axiado.com>
Date: Mon, 13 Apr 2026 05:58:03 -0700
Subject: [PATCH] RGB color swapping for axiado kvm

Signed-off-by: Ginu George <axiado-2551@axiado.com>
---
 src/libvncserver/main.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/libvncserver/main.c b/src/libvncserver/main.c
index 1efa8387..1c502f96 100644
--- a/src/libvncserver/main.c
+++ b/src/libvncserver/main.c
@@ -898,9 +898,9 @@ static void rfbInitServerFormat(rfbScreenInfoPtr screen, int bitsPerSample)
      format->greenMax = (1 << bitsPerSample) - 1;
      format->blueMax = (1 << bitsPerSample) - 1;
      if(rfbEndianTest) {
-       format->redShift = 0;
+       format->blueShift = 0;
        format->greenShift = bitsPerSample;
-       format->blueShift = bitsPerSample * 2;
+       format->redShift = bitsPerSample * 2;
      } else {
        if(format->bitsPerPixel==8*3) {
 	 format->redShift = bitsPerSample*2;
-- 
